{
  "algorithm": "sac",
  "total_timesteps": 1000000,
  "device": "cuda",
  "seed": 42,
  "n_envs": 1,
  "learning_rate": 0.0001,
  "gamma": 0.995,
  "batch_size": 256,
  "net_arch": [256, 256],
  "activation_fn": "relu",
  "stats_window_size": 200,
  "checkpoint_freq": 50000,
  "evaluation_freq": 25000,
  "n_eval_episodes": 3,
  "deterministic_eval": true,
  "save_replay_buffer": true,
  "ppo_n_steps": 1024,
  "ppo_n_epochs": 10,
  "ppo_gae_lambda": 0.95,
  "ppo_clip_range": 0.2,
  "ppo_clip_range_vf": null,
  "ppo_normalize_advantage": true,
  "ppo_ent_coef": 0.005,
  "ppo_vf_coef": 0.5,
  "ppo_max_grad_norm": 0.5,
  "ppo_use_sde": false,
  "ppo_sde_sample_freq": -1,
  "ppo_target_kl": null,
  "sac_buffer_size": 500000,
  "sac_learning_starts": 20000,
  "sac_tau": 0.005,
  "sac_train_freq": 1,
  "sac_train_freq_unit": "step",
  "sac_gradient_steps": 1,
  "sac_optimize_memory_usage": false,
  "sac_n_steps": 1,
  "sac_ent_coef": "auto_0.01",
  "sac_target_update_interval": 1,
  "sac_target_entropy": "auto",
  "sac_use_sde": false,
  "sac_sde_sample_freq": -1,
  "sac_use_sde_at_warmup": false,
  "sac_action_noise": "normal",
  "sac_action_noise_sigma": 0.05
}
