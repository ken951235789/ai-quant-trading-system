# 請複製為 .env 後填入需要使用的環境；.env 已被 Git 忽略。
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# 真實資金環境的第二道總開關；只有完全等於 YES 才能送單。
AI_QUANT_LIVE_TRADING_ENABLED=NO

# 選填：Discord／Slack 相容 Webhook；只有 warning、error、critical 會外傳。
AI_QUANT_NOTIFICATION_WEBHOOK_URL=
# 限制可接收通知的 HTTPS 主機，避免環境變數遭竄改後把資訊送往陌生端點。
AI_QUANT_NOTIFICATION_ALLOWED_HOSTS=hooks.slack.com,discord.com

# 選填：實盤異常 Email。只有完全等於 YES 才會啟用，密碼請使用信箱供應商的應用程式密碼。
AI_QUANT_EMAIL_ENABLED=NO
AI_QUANT_EMAIL_SMTP_HOST=smtp.gmail.com
AI_QUANT_EMAIL_SMTP_PORT=465
# 只接受 ssl 或 starttls，不支援明文 SMTP。
AI_QUANT_EMAIL_SECURITY=ssl
AI_QUANT_EMAIL_USERNAME=
AI_QUANT_EMAIL_PASSWORD=
# 留空時使用 AI_QUANT_EMAIL_USERNAME；多個收件者以半形逗號分隔。
AI_QUANT_EMAIL_FROM=
AI_QUANT_EMAIL_TO=
# 預設只寄錯誤與重大錯誤；需要一般警告時改為 warning,error,critical。
AI_QUANT_EMAIL_LEVELS=error,critical
AI_QUANT_EMAIL_NOTIFY_RECOVERY=YES
AI_QUANT_EMAIL_SUBJECT_PREFIX=[AI Quant]
AI_QUANT_EMAIL_TIMEOUT_SECONDS=10

# 交易狀態儲存後端。尚未啟動 PostgreSQL 時維持 file，切換後不可靜默退回檔案模式。
AI_QUANT_STORAGE_BACKEND=file
AI_QUANT_DATABASE_URL=postgresql+psycopg://ai_quant_app:change_me@127.0.0.1:5432/ai_quant

# Docker Compose 建立本機 PostgreSQL 時使用；正式環境請改由祕密管理服務提供。
POSTGRES_DB=ai_quant
POSTGRES_USER=ai_quant_app
POSTGRES_PASSWORD=change_me

# Grafana 僅綁定本機，仍必須使用獨立強密碼。
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# 備份至少保留一份在不同磁碟或 NAS；同一實體硬碟的不同分割區不算真正異地備援。
AI_QUANT_BACKUP_DIR=D:\AIQuantTradingSystem\data\database\backups
AI_QUANT_BACKUP_SECONDARY_DIR=C:\Users\你的帳號\AIQuantBackups
